#ifndef COORDINATE_H
#define COORDINATE_H

#include <iostream>
#include <vector>
#include <cmath>

// Koordináta struktúra az adatok tárolására és validálására
struct Coordinate {
    double latitude;
    double longitude;
    bool visited; // Nyomon követi, hogy érintettük-e már az útvonal során

    // Alapértelmezett konstruktor
    Coordinate() : latitude(0.0), longitude(0.0), visited(false) {}
    Coordinate(double lat, double lon) : latitude(lat), longitude(lon), visited(false) {}

    // Hibás/érvénytelen bemenetek kezeléséhez (alapvető GPS tartományellenőrzés)
    bool isValid() const {
        return (latitude >= -90.0 && latitude <= 90.0) && (longitude >= -180.0 && longitude <= 180.0);
    }
};

class RoutePlanner {
private:
    Coordinate startNode;
    Coordinate* targets; // Dinamikusan foglalt tömb a további koordinátáknak
    int targetCount;
    std::vector<Coordinate> finalRoute; // A kiszámított útvonal sorrendje
    double totalDistance;

public:
    // Konstruktor és destruktor (dinamikus memória felszabadítása)
    RoutePlanner();
    ~RoutePlanner();

    // Felhasználói bevitelek kezelése hibaellenőrzéssel
    void inputData();
    
    // Távolságszámítás (Egyszerűsített euklideszi távolság)
    double calculateDistance(const Coordinate& c1, const Coordinate& c2) const;
    
    // Útvonaltervező algoritmus (Legközelebbi szomszéd + 20m-es szabály)
    void planRoute();
    
    // Eredmények kiíratása
    void printResults() const;
};

#endif // COORDINATE_H



//cpp file

#include "Coordinate.h"
#include <iomanip>
#include <limits>

RoutePlanner::RoutePlanner() : targets(nullptr), targetCount(0), totalDistance(0.0) {}

RoutePlanner::~RoutePlanner() {
    // Dinamikusan lefoglalt tömb felszabadítása
    if (targets != nullptr) {
        delete[] targets;
    }
}

void RoutePlanner::inputData() {
    // 1. Kiinduló koordináta bekérése validálással
    while (true) {
        std::cout << "Adja meg a kiindulo koordinatat (szelesseg hosszusag, pl. 47.53 21.62): ";
        if (std::cin >> startNode.latitude >> startNode.longitude && startNode.isValid()) {
            break;
        }
        std::cout << "Ervenytelen koordinatak! Kerem probalja ujra.\n";
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    }

    // 2. További koordináták számának bekérése
    while (true) {
        std::cout << "Hany tovabbi koordinatat szeretne megadni? ";
        if (std::cin >> targetCount && targetCount > 0) {
            break;
        }
        std::cout << "Pozitiv egesz szamot adjon meg!\n";
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    }

    // Dinamikusan lefoglalt tömb létrehozása
    targets = new Coordinate[targetCount];

    // További koordináták beolvasása
    for (int i = 0; i < targetCount; ++i) {
        while (true) {
            std::cout << "  " << i + 1 << ". koordinata (szelesseg hosszusag): ";
            if (std::cin >> targets[i].latitude >> targets[i].longitude && targets[i].isValid()) {
                break;
            }
            std::cout << "  Ervenytelen koordinatak! Probalja ujra.\n";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        }
    }
}

// Egyszerűsített euklideszi távolság
// Megjegyzés: A GPS koordináták fokban vannak. A méterben történő távolsághoz egy közelítő 
// szorzót alkalmazunk (1 fok a Földön kb. 111 000 méter).
double RoutePlanner::calculateDistance(const Coordinate& c1, const Coordinate& c2) const {
    double dLat = (c1.latitude - c2.latitude) * 111000.0;
    double dLon = (c1.longitude - c2.longitude) * 111000.0 * cos(c1.latitude * M_PI / 180.0);
    return std::sqrt(dLat * dLat + dLon * dLon);
}

void RoutePlanner::planRoute() {
    finalRoute.clear();
    totalDistance = 0.0;

    // A kiindulópont az első elem az útvonalban
    Coordinate currentPos = startNode;
    finalRoute.push_back(currentPos);

    int visitedNodes = 0;

    while (visitedNodes < targetCount) {
        int nextIndex = -1;
        double minDistance = std::numeric_limits<double>::max();

        // 1. Megkeressük az aktuális pozícióhoz legközelebbi MÉG NEM érintett pontot
        for (int i = 0; i < targetCount; ++i) {
            if (!targets[i].visited) {
                double dist = calculateDistance(currentPos, targets[i]);
                if (dist < minDistance) {
                    minDistance = dist;
                    nextIndex = i;
                }
            }
        }

        if (nextIndex == -1) break; // Ha nincs több elérhető pont

        Coordinate chosenTarget = targets[nextIndex];
        targets[nextIndex].visited = true;
        visitedNodes++;

        // 2. Köztes koordináta vizsgálata (20 méteres szabály):
        // Ha a jelenlegi pont (kezdőpont az aktuális szakaszban) és a választott végpont közötti 
        // egyenes útvonalhoz képest egy MÁSIK szabad köztes pont 20 méternél közelebb van,
        // akkor azt is beiktatjuk útközben.
        for (int i = 0; i < targetCount; ++i) {
            if (!targets[i].visited) {
                // Egyszerűsített vizsgálat: Ha a köztes pont közelebb van a szakasz végpontjához 20 méternél
                double distToTarget = calculateDistance(targets[i], chosenTarget);
                if (distToTarget < 20.0) {
                    finalRoute.push_back(targets[i]);
                    totalDistance += calculateDistance(currentPos, targets[i]);
                    currentPos = targets[i];
                    targets[i].visited = true;
                    visitedNodes++;
                }
            }
        }

        // Hozzáadjuk a fő legközelebbi pontot az útvonalhoz
        totalDistance += calculateDistance(currentPos, chosenTarget);
        currentPos = chosenTarget;
        finalRoute.push_back(currentPos);
    }
}

void RoutePlanner::printResults() const {
    std::cout << "\n================ UTTERV EREDMENYEK ================\n";
    std::cout << "Az optimalizalt utvonal sorrendje:\n";
    
    for (size_t i = 0; i < finalRoute.size(); ++i) {
        std::cout << "  [" << i << "] -> Szelesseg: " << std::fixed << std::setprecision(5) 
                  << finalRoute[i].latitude << ", Hosszusag: " << finalRoute[i].longitude;
        if (i == 0) std::cout << " (KIINDULOPONT)";
        std::cout << "\n";
    }
    
    std::cout << "---------------------------------------------------\n";
    std::cout << "A teljes utvonal becsult hossza: " << std::fixed << std::setprecision(2) 
              << totalDistance << " meter\n";
    std::cout << "===================================================\n";
}



