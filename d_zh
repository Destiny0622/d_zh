// --- OSZTÁLY DEFINÍCIÓ ---
class Character {
protected:
    std::string nev;
    double eletero;
    double tamadasi_ero;
    int szint;

public:
    // Konstruktorok
    Character() : nev("Ismeretlen"), eletero(100.0), tamadasi_ero(10.0), szint(1) {}
    
    Character(std::string n, double el, double t_ero, int sz) 
        : nev(n), eletero(el), tamadasi_ero(t_ero), szint(sz) {}

    // Destruktor
    virtual ~Character() {
        // Dinamikus memóriakezelés hiányában üres, de a feladat kéri
    }

    // Lekérdező (getter) és beállító (setter) metódusok
    std::string getNev() const { return nev; }
    void setNev(std::string n) { nev = n; }

    double getEletero() const { return eletero; }
    void setEletero(double el) { eletero = el; }

    double getTamadasiEro() const { return tamadasi_ero; }
    void setTamadasiEro(double t_ero) { tamadasi_ero = t_ero; }

    int getSzint() const { return szint; }
    void setSzint(int sz) { szint = sz; }

    // Szintlépés metódus (véletlenszerű növelés)
    void szintLepes() {
        szint++;
        
        // 10% és 20% közötti véletlenszerű érték (generálás: 10 + [0..10])
        double eletero_szorzo = 1.0 + (10 + rand() % 11) / 100.0;
        eletero *= eletero_szorzo;

        // 5% és 15% közötti véletlenszerű érték (generálás: 5 + [0..10])
        double tamadas_szorzo = 1.0 + (5 + rand() % 11) / 100.0;
        tamadasi_ero *= tamadas_szorzo;
    }

    // Fájlba írás tetszőleges formátumban
    void fajlbaIr(std::ofstream& fajl) const {
        if (fajl.is_open()) {
            fajl << nev << " " << eletero << " " << tamadasi_ero << " " << szint << "\n";
        }
    }

    // Konzolos kiírás a teszteléshez
    void kiir() const {
        std::cout << "Nev: " << nev << " | Eletero: " << eletero 
                  << " | Tamado ero: " << tamadasi_ero << " | Szint: " << szint << std::endl;
    }

    // Beolvasó operátor túlterhelése (barát függvényként, de az osztályhoz kötve)
    friend std::istream& operator>>(std::istream& is, Character& c) {
        // Formátum: név életerő támadóerő szint
        is >> c.nev >> c.eletero >> c.tamadasi_ero >> c.szint;
        return is;
    }
};

// --- SZÁRMAZTATOTT KARAKTERTÍPUSOK ---
// 1. Származtatott osztály: Harcos
class Warrior : public Character {
private:
    double pajzs;
public:
    Warrior(std::string n, double el, double t_ero, int sz, double p) 
        : Character(n, el, t_ero, sz), pajzs(p) {}
    
    // Felüldefiniált kiírás a plusz attribútum miatt
    void kiir() const {
        Character::kiir();
        std::cout << " -> Extra (Pajzs): " << pajzs << std::endl;
    }
};

// 2. Származtatott osztály: Mágus
class Mage : public Character {
private:
    int mana;
public:
    Mage(std::string n, double el, double t_ero, int sz, int m) 
        : Character(n, el, t_ero, sz), mana(m) {}

    void kiir() const {
        Character::kiir();
        std::cout << " -> Extra (Mana): " << mana << std::endl;
    }
};

// --- FŐPROGRAM (MAIN) ---
int main() {
    // Véletlenszám generátor inicializálása
    srand(time(0));

    std::cout << "--- Statikus es dinamikus peldanyositas, metodusok hivasa ---\n";

    // Statikus példányosítás (Stack)
    Character statikusKarakter("Arthur", 120.0, 15.0, 1);
    std::cout << "Statikus karakter letrehozva:\n";
    statikusKarakter.kiir();

    // Szintlépés tesztelése
    statikusKarakter.szintLepes();
    std::cout << "Szintlepes utan:\n";
    statikusKarakter.kiir();

    std::cout << "\n---------------------------------------------------------\n";

    // Dinamikus példányosítás (Heap)
    Character* dinamikusKarakter = new Character("Merlin", 80.0, 25.0, 2);
    std::cout << "Dinamikus karakter letrehozva:\n";
    dinamikusKarakter->kiir();
    
    // Setter/Getter használata
    dinamikusKarakter->setEletero(95.0);
    std::cout << "Modositott eletero (Getterrel lekerve): " << dinamikusKarakter->getEletero() << "\n";

    std::cout << "\n--- Szarmaztatott osztalyok tesztelese ---\n";
    Warrior harcos("Thor", 200.0, 35.0, 5, 50.0);
    Mage magus("Gandalf", 90.0, 40.0, 7, 150);
    
    harcos.kiir();
    magus.kiir();

    std::cout << "\n--- Fajlba iras tesztelese ---\n";
    std::ofstream kimenet("karakterek.txt");
    if (kimenet.is_open()) {
        statikusKarakter.fajlbaIr(kimenet);
        dinamikusKarakter->fajlbaIr(kimenet);
        harcos.fajlbaIr(kimenet); // Ősosztály metódusa hívódik meg
        kimenet.close();
        std::cout << "Karakterek sikeresen mentve a 'karakterek.txt' fajlba.\n";
    }

    std::cout << "\n--- Beolvaso operator (>>) tesztelese ---\n";
    Character ujKarakter;
    std::cout << "Adj meg egy uj karaktert (Formatum: Nev Eletero TamadoEro Szint): \n";
    // Minta bemenet: Legolas 110 18 3
    std::cin >> ujKarakter; 
    
    std::cout << "A beolvasott karakter adatai:\n";
    ujKarakter.kiir();

    // Dinamikusan lefoglalt memória felszabadítása (Destruktor hívás)
    delete dinamikusKarakter;

    return 0;
}



